# ============================================================
# TERRAFORM
# ============================================================

# Local Terraform working directories
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform crash logs
crash.log
crash.*.log

# Terraform plan files
*.tfplan
*.plan

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI configuration
.terraformrc
terraform.rc


# ============================================================
# TERRAFORM VARIABLES / SECRETS
# ============================================================

# Do not commit environment-specific secret tfvars
*.auto.tfvars
*.auto.tfvars.json

# Keep real secret variable files out of Git
*.secret.tfvars
*.secrets.tfvars

# Optional local variable files
terraform.tfvars.local
*.tfvars.local


# ============================================================
# AWS / KUBERNETES CREDENTIALS
# ============================================================

.aws/
kubeconfig
kubeconfig.*
.kube/
credentials
credentials.json


# ============================================================
# ANSIBLE
# ============================================================

*.retry
ansible.retry

# Vault password files
.vault_pass
.vault-password
vault-password.txt

# Local Ansible secrets
ansible/secrets/
ansible/group_vars/*/vault.yml
ansible/group_vars/*/secrets.yml


# ============================================================
# ENVIRONMENT / SECRET FILES
# ============================================================

.env
.env.*
!.env.example

*.pem
*.key
*.p12
*.pfx


# ============================================================
# LOGS / TEMP FILES
# ============================================================

*.log
tmp/
temp/
.cache/


# ============================================================
# macOS
# ============================================================

.DS_Store
.AppleDouble
.LSOverride


# ============================================================
# IDE / EDITOR
# ============================================================

.vscode/
.idea/
*.swp
*.swo
*~


# ============================================================
# PYTHON
# ============================================================

__pycache__/
*.py[cod]
.venv/
venv/